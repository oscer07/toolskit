<Window x:Class="ToolkitApp.Views.ToolDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tool Details" Height="600" Width="800"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Tool Details &amp; Configuration" Foreground="White" FontSize="28" FontWeight="Light" Margin="0,0,0,20"/>

        <!-- Editable Fields -->
        <Border Grid.Row="1" Background="{StaticResource BgMediumBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="0,0,0,15" Padding="5" FontSize="14" 
                         Background="#111" Foreground="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Command:" Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="txtCommand" Grid.Row="1" Grid.Column="1" Margin="0,0,0,15" Padding="5" FontSize="14" FontFamily="Consolas"
                         Background="#111" Foreground="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Shell:" Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" FontSize="14"/>
                <ComboBox x:Name="cmbShell" Grid.Row="2" Grid.Column="1" Padding="5" FontSize="14" HorizontalAlignment="Left" Width="150">
                    <ComboBoxItem Content="cmd"/>
                    <ComboBoxItem Content="powershell"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- README Viewer -->
        <Border Grid.Row="2" Background="#0C0C0C" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Background="#1A1A1A" CornerRadius="8,8,0,0" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="10,5">
                    <TextBlock Text="Documentation / README" Foreground="#AAA" FontSize="12" FontWeight="Bold"/>
                </Border>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="10">
                    <TextBlock x:Name="txtReadme" Foreground="#CCC" FontSize="14" FontFamily="Consolas" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnSave" Content="Save Changes" Width="120" Height="35" Click="BtnSave_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnClose" Content="Close" Width="100" Height="35" Click="BtnClose_Click" Background="#444"/>
        </StackPanel>
    </Grid>
</Window>
