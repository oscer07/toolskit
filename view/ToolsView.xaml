<UserControl x:Class="ToolkitApp.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDarkBrush}"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Tools List and Add -->
        <Border Grid.Column="0" BorderBrush="#444" BorderThickness="0,0,1,0" Padding="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <TextBox x:Name="txtSearch" Grid.Row="0" Margin="0,0,0,10" 
                         Height="30" VerticalContentAlignment="Center"
                         TextChanged="TxtSearch_TextChanged"/>
                <TextBlock Grid.Row="0" Text="Search tools..." Foreground="#777" Margin="10,0,0,10" 
                           VerticalAlignment="Center" IsHitTestVisible="False" x:Name="lblSearchHint"/>

                <!-- Tools List -->
                <ListBox x:Name="lstTools" Grid.Row="1" Background="{StaticResource BgMediumBrush}" 
                         Foreground="{StaticResource TextLightBrush}" BorderThickness="0"
                         SelectedItem="{Binding SelectedTool}" HorizontalContentAlignment="Stretch"
                         AllowDrop="True" Drop="LstTools_Drop" MouseDoubleClick="LstTools_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{Binding Command}" FontSize="12" Foreground="#888" FontFamily="Consolas" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,20" HorizontalAlignment="Center">
                    <Button x:Name="btnRun" Content="Run" Width="100" Margin="0,0,10,0" Click="BtnRun_Click"/>
                    <Button x:Name="btnRunAdmin" Content="Run as Admin" Width="120" Background="#CC3300" Click="BtnRunAdmin_Click"/>
                </StackPanel>

                <!-- Add New Tool -->
                <Border Grid.Row="3" Background="{StaticResource BgMediumBrush}" CornerRadius="5" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Add / Install Tool" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Name:" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtNewName" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Command:" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtNewCommand" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Shell:" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="cmbShell" Margin="0,0,0,10">
                            <ComboBoxItem Content="cmd" IsSelected="True"/>
                            <ComboBoxItem Content="powershell"/>
                        </ComboBox>

                        <Button x:Name="btnAdd" Content="Add Tool" Click="BtnAdd_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right Panel: Terminal Output -->
        <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="8" Background="#0C0C0C" BorderBrush="#333" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Terminal Title Bar -->
                <Border Grid.Row="0" Background="#1A1A1A" CornerRadius="8,8,0,0" BorderBrush="#333" BorderThickness="0,0,0,1">
                    <TextBlock Text="Terminal Output" Foreground="#AAA" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <!-- Terminal Body -->
                <RichTextBox x:Name="txtTerminal" Grid.Row="1" Background="Transparent" Foreground="{StaticResource TextTerminalBrush}" 
                         FontFamily="Consolas" FontSize="14" BorderThickness="0" Padding="15"
                         IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <FlowDocument PagePadding="0" Background="Transparent" />
                </RichTextBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
